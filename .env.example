# ⚠️  WARNING: Never put a privileged/service key in a Vite env var — it ships to the browser.
# Use public anon keys with row-level security, or an edge function proxy.

# Network adapter provider: 'null' | 'supabase' | 'firebase' | 'turso' | 'webrtc-db'
VITE_NET_PROVIDER=null

# Adapter endpoint (e.g. Supabase project URL)
VITE_NET_URL=

# Public anon key (NOT a service role key!)
VITE_NET_KEY=
