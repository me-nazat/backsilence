# ── Client-side Environment Variables (Vite) ──────────────────────────────────
# ⚠️  SECURITY NOTICE: Variables prefixed with VITE_* are bundled into client JS.
# NEVER place database tokens, server secrets, or admin credentials here.
# The browser communicates with the online platform exclusively via /api/* proxy.

# Network adapter provider: 'loopback' | 'local-tab' | 'turso-proxy' | 'webrtc-db'
VITE_NET_PROVIDER=loopback

# API proxy base URL (relative '/api' for same-origin dev/prod, or absolute URL for remote edge workers)
VITE_API_BASE=/api
