# ⚠️  WARNING: Never put a privileged/service key in a Vite env var — it ships to the browser.
# Use public anon keys with row-level security, or an edge function proxy.

# Network adapter provider: 'null' | 'loopback' | 'local-tab' | 'supabase' | 'firebase' | 'turso' | 'webrtc-db'
VITE_NET_PROVIDER=loopback

# ── Option A: Generic Network Variables ───────────────────────────────────────
# Adapter endpoint (e.g. Supabase project URL or Turso libSQL URL)
VITE_NET_URL=
# Public key or token (e.g. Supabase anon key or Turso DB auth token)
VITE_NET_KEY=

# ── Option B: Turso / libSQL Specific ─────────────────────────────────────────
# Turso database URL (format: https://your-database-slug.turso.io)
# VITE_TURSO_URL=https://your-database-slug.turso.io
# Turso auth token (generated via `turso db tokens create <db-name>`)
# VITE_TURSO_AUTH_TOKEN=your_jwt_token_here

