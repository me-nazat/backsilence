{
  "name": "backsilence",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "vite-node scripts/dev-api-proxy.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "deploy:preview": "npm run build && vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "audit": "node scripts/audit-bundle.mjs",
    "secret:scan": "node scripts/secret-scan.mjs",
    "i18n:check": "node scripts/i18n/check.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run audit && npm run secret:scan && npm run i18n:check",
    "verify:all": "npm run verify && node scripts/monster-trace.mjs && node scripts/perf/run-perf.mjs && npm run shots:check && npm run reference:compare && npm run audio:compare",
    "shots": "node scripts/shots.mjs",
    "shots:check": "node scripts/visual/compare.mjs --check",
    "shots:approve": "node scripts/visual/compare.mjs --approve",
    "smoke": "node scripts/smoke/run-smoke.mjs",
    "test:cross-engine": "vite-node scripts/test-cross-engine.mjs",
    "balance": "node scripts/balance/run-balance.mjs",
    "browser:acceptance": "node scripts/browser-acceptance.mjs",
    "perf": "node scripts/perf/run-perf.mjs",
    "reference:compare": "node scripts/reference/compare.mjs",
    "audio:compare": "node scripts/audio/compare.mjs"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/three": "0.170.0",
    "axe-core": "^4.14.0",
    "eslint": "10.13.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-node": "6.0.0",
    "vitest": "5.0.5"
  }
}
